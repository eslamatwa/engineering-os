{
  "schema": "engos/policies@1",
  "threat_model": {
    "protects_against": [
      "honest_mistakes",
      "model_misled_by_injected_instructions"
    ],
    "out_of_scope_v0_1": [
      "model_deliberately_bypassing_rules",
      "os_level_isolation"
    ],
    "readme_statement": "Engineering OS prevents common mistakes and detects indirect changes inside the repo after they happen. It is not a sandbox and does not stop a model that is deliberately trying to get around it.\n"
  },
  "modes": {
    "read_only": {
      "allowed": [
        "read",
        "search",
        "configured_checks_without_side_effects"
      ],
      "denied": [
        "Edit",
        "Write",
        "NotebookEdit",
        "mutating_bash"
      ]
    },
    "workspace_write": {
      "allowed": [
        "edit_inside_scope",
        "local_git",
        "configured_checks",
        "local_package_install_observed"
      ],
      "denied": [
        "external_actions_without_approval"
      ]
    },
    "default_mode": "read_only",
    "requires_git_for_write": true
  },
  "hard_gates": [
    {
      "id": "G-delivery",
      "when": "bash class in [vcs_remote, network, destructive] or external MCP tool",
      "require": "approval_per_action"
    },
    {
      "id": "G-protected",
      "when": "write to high_risk protected path",
      "require": "scope_approval"
    },
    {
      "id": "G-never",
      "when": "write to never path",
      "require": "deny"
    },
    {
      "id": "G-self",
      "when": "bash class self_protect (includes running claude, D34)",
      "require": "deny"
    },
    {
      "id": "G-prod",
      "when": "deploy to production",
      "require": "deny"
    }
  ],
  "approvals": {
    "only_from": "human",
    "request_written_by": "gate",
    "records": ".engos/approvals/APR-xxxxxxxx.json",
    "native_prompt": {
      "used_for": [
        "vcs_remote",
        "network",
        "destructive",
        "unknown_in_high_risk",
        "protected_file_first_edit_in_task"
      ],
      "modes": [
        "default",
        "acceptEdits",
        "auto",
        "bypassPermissions"
      ],
      "shows": "real_action",
      "granted_when": "tool_ran",
      "no_is_invisible": true
    },
    "actions": {
      "every_execution_asks": true,
      "context_recorded": [
        "branch",
        "outgoing_commits",
        "after_push_head"
      ]
    },
    "protected_files": {
      "approval": "per_file_per_task",
      "max_lifetime": "24h"
    },
    "request_ttl": "1h",
    "headless": "denied_by_platform",
    "blanket_approvals": false,
    "typed_commands": [
      "/engos:decide TASK-xxx accept|stop",
      "/engos:class TASK-xxx <lower class>",
      "/engos:pause",
      "/engos:resume"
    ],
    "typed_capture": {
      "hook": "UserPromptExpansion",
      "match": "whole_line",
      "require_same_session_as_task": true,
      "void_if_session_resumed_or_forked_after_request": true,
      "rearm": "engos task rearm TASK-xxx"
    }
  },
  "pause": {
    "command": "/engos:pause",
    "typed_by": "human",
    "lasts": "current_session",
    "turns_off": [
      "classification",
      "plans",
      "validation"
    ],
    "keeps": "hard_gates"
  },
  "knowledge": {
    "never_store": [
      "secrets",
      "tokens",
      "private_keys",
      "raw_credentials"
    ],
    "facts_need_source": true,
    "assumptions_marked": true,
    "secret_found_in_diff_or_state": "needs_human"
  },
  "state_files": {
    "changed_only_by": "engos_cli",
    "committed": [
      ".engos/config.yaml",
      ".engos/BRIEF.md",
      ".engos/STATE.yaml"
    ],
    "local_only": [
      ".engos/tasks/",
      ".engos/approvals/",
      ".engos/ledger.jsonl",
      ".engos/status.json"
    ]
  },
  "platform": {
    "surfaces": {
      "supported": [
        "terminal_cli",
        "desktop_code_tab",
        "ide_extensions",
        "remote_control_from_phone"
      ],
      "to_verify": [
        "claude_code_web"
      ],
      "not_supported": [
        "desktop_chat_tab",
        "claude_ai",
        "mobile_chat",
        "cowork"
      ]
    },
    "min_claude_code": "first version with hook onFailure: block (tested on 2.1.321)",
    "min_claude_code_version": "2.1.321",
    "version_source": "CLAUDE_CODE_EXECPATH --version",
    "version_unknown": "warn",
    "older_version": "start_read_only_and_ask_to_update",
    "runtime": "node",
    "runtime_missing": "block_with_install_instructions",
    "hooks_on_failure": "block"
  }
}
